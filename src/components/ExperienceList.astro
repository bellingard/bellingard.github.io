---
import type { Position } from "../lib/profile";

interface Props {
  positions: Position[];
  /** When true, extend the timeline with a dashed segment to hint at more entries. */
  continues?: boolean;
}

const { positions, continues = false } = Astro.props;
---

<div>
  <ol class="relative">
    {
      positions.map((job, index) => {
        const isFirst = index === 0;
        const isLast = index === positions.length - 1;
        const showLineBelow = !isLast || continues;

        return (
          <li class="relative grid grid-cols-[0.75rem_minmax(0,1fr)] gap-x-4">
            <div class="relative flex justify-center self-stretch" aria-hidden="true">
              {
                showLineBelow && (
                  <span
                    class:list={[
                      "absolute left-1/2 bottom-0 w-px -translate-x-1/2 bg-forest/15",
                      // First item: start at circle center. Later items: from the top so
                      // the segment meets the previous one without a gap.
                      isFirst ? "top-3" : "top-0",
                    ]}
                  />
                )
              }
              <span class="relative z-10 mt-1.5 h-3 w-3 shrink-0 rounded-full border-2 border-moss bg-snow" />
            </div>
            <div class:list={[showLineBelow ? "pb-10" : ""]}>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-glacier">
                {job.startedOn}
                {job.finishedOn ? ` — ${job.finishedOn}` : " — Present"}
              </p>
              <h3 class="mt-2 font-display text-xl font-semibold text-forest">
                {job.title}
                <span class="font-body text-base font-normal text-ink/55"> · {job.company}</span>
              </h3>
              {job.location && <p class="mt-1 text-sm text-ink/55">{job.location}</p>}
              {job.description && (
                <p class="mt-3 max-w-2xl text-base leading-7 text-ink/75">{job.description}</p>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
  {
    continues && (
      <div class="grid grid-cols-[0.75rem_minmax(0,1fr)] gap-x-4" aria-hidden="true">
        <div class="flex justify-center">
          <span class="timeline-dash h-14 w-px" />
        </div>
      </div>
    )
  }
</div>

<style>
  .timeline-dash {
    background-image: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-forest) 15%, transparent) 0 3px,
      transparent 3px 7px
    );
  }
</style>
