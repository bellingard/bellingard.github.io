---
import {
  BookOpen,
  Briefcase,
  CodeXml,
  Leaf,
  Share2,
  Sparkles,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProfile } from "../lib/profile";

const profile = getProfile();

const sections = [
  { label: "Experience", href: "/experience", icon: Briefcase },
  { label: "Impact", href: "/impact", icon: Leaf },
  { label: "Open source", href: "/open-source", icon: CodeXml },
  { label: "Skills", href: "/skills", icon: Sparkles },
  { label: "Publications", href: "/publications", icon: BookOpen },
  { label: "Social", href: "/social", icon: Share2 },
] as const;
---

<BaseLayout>
  <section>
    <div class="mx-auto grid w-full max-w-5xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start lg:gap-14">
      <div class="order-2 lg:order-1">
        <h1 class="reveal font-display text-4xl font-semibold leading-[1.08] tracking-tight text-forest sm:text-5xl lg:text-6xl">
          {profile.name}
        </h1>
        <p class="reveal reveal-delay-1 mt-6 max-w-2xl text-lg leading-8 text-ink/75">
          {profile.tagline}
        </p>
        <div class="reveal reveal-delay-2 mt-6 max-w-2xl space-y-4 text-base leading-7 text-ink/80">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <nav class="reveal reveal-delay-3 mt-10" aria-label="Sections">
          <ul class="flex flex-wrap gap-3">
            {
              sections.map(({ label, href, icon: Icon }) => (
                <li>
                  <a
                    class="group flex h-[6.25rem] w-[5.5rem] flex-col items-center justify-between rounded-xl border border-forest/12 bg-snow/80 px-2 py-3 text-center transition hover:border-glacier/40 hover:bg-mist/50"
                    href={href}
                  >
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-glacier/12 text-glacier transition group-hover:bg-glacier/20 group-hover:text-forest">
                      <Icon size={20} stroke-width={2} aria-hidden="true" />
                    </span>
                    <span class="font-display flex h-8 items-center justify-center text-[0.68rem] font-medium leading-tight text-ink/70 group-hover:text-forest">
                      {label}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="reveal order-1 justify-self-center lg:order-2 lg:justify-self-end lg:pt-6">
        <figure class="relative">
          <div
            aria-hidden="true"
            class="absolute -inset-2 rounded-[1.5rem] bg-gradient-to-br from-glacier/25 via-moss/10 to-transparent lg:-inset-2.5"
          ></div>
          <img
            class="relative h-44 w-44 rounded-3xl object-cover shadow-lg shadow-forest/10 sm:h-48 sm:w-48 lg:h-40 lg:w-40"
            src={profile.photo}
            alt={profile.photoAlt}
            width="160"
            height="160"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>
