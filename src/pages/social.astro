---
import { ArrowUpRight, Share2 } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import { getProfile } from "../lib/profile";

const profile = getProfile();
---

<BaseLayout
  title={`Social — ${profile.name}`}
  description="Profiles and presence across the web."
  canonicalPath="/social"
>
  <Section
    id="social"
    eyebrow="Social"
    icon={Share2}
    title="Find me elsewhere"
    intro="Profiles and presence across the web."
    tone="snow"
  >
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        profile.social.map((link) => (
          <li>
            <a
              class="group flex items-start justify-between gap-3 rounded-lg border border-forest/10 bg-paper px-4 py-3 transition hover:border-glacier/40 hover:bg-mist/40"
              href={link.href}
              rel={link.rel ?? "noopener noreferrer"}
              target="_blank"
            >
              <span>
                <span class="font-display block text-base font-semibold text-forest group-hover:text-glacier">
                  {link.label}
                </span>
                {link.description && <span class="mt-0.5 block text-sm text-ink/55">{link.description}</span>}
              </span>
              <ArrowUpRight class="mt-0.5 shrink-0 text-ink/35 transition group-hover:text-glacier" size={18} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
